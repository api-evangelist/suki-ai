        {
          "info": {
            "name": "Get Session Recording URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sdp.suki-stage.com/api/v1/ambient/sessions/:sessionId/recording",
            "params": [
              {
                "name": "sessionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Session Recording URL"
        },
        {
          "info": {
            "name": "Get Session Structured Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sdp.suki-stage.com/api/v1/ambient/sessions/:sessionId/structured-data",
            "params": [
